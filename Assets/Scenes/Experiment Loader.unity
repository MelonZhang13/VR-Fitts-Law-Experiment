  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "In this experiment, you will perform target selection tasks using two
    interaction methods: a <color=#00FF7F><b>virtual hand ray</b></color> and a 
    <color=#00FF7F><b>controller-based ray</b></color>. Seven circular targets are
    arranged in a ring formation. Please select <color=#1E90FF><b>the blue target</b></color>
    in sequence as it appears.\nYou are asked to balance both speed and accuracy\u2014<color=#00FF7F><b>try
    to click the targets as quickly and precisely as possible</b></color>. You are
    <color=#00FF7F>not allowed to take a break during a round</b></color>. After
    each round of target selection, you can <color=#00FF7F>take a break</color> at
    any time. When you are ready to continue, click the center button to start the
    next round.\nNow, please enter your personal information and begin the experiment."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
